+    /// Invoke the popup synthesized from `ui.new_workspace_command` instead of
+    /// creating a workspace directly. Returns false when no such command is
+    /// configured, or when nothing is focused yet, so the caller falls back to
+    /// the built-in creation path.
+    pub(super) fn invoke_new_workspace_command(&mut self, outcome: &mut ClientShellInput) -> bool {
+        let Some(params) = self.snapshot.as_deref().and_then(|snapshot| {
+            let command = snapshot.commands.iter().find(|candidate| {
+                candidate.binding_label == crate::config::NEW_WORKSPACE_COMMAND_LABEL
+                    && candidate.action == crate::protocol::ClientShellCommandAction::Popup
+            })?;
+            // A popup is drawn over the focused workspace, so the first
+            // workspace of a session is still created without the picker.
+            snapshot.focused_workspace_id.as_ref()?;
+            Some(crate::api::schema::CommandInvokeParams {
+                command_id: command.command_id.clone(),
+                workspace_id: snapshot.focused_workspace_id.clone(),
+                tab_id: snapshot.focused_tab_id.clone(),
+                pane_id: snapshot.focused_pane_id.clone(),
+                selection: None,
+            })
+        }) else {
+            return false;
+        };
+
+        self.popup_pending = true;
+        self.popup_pending_deadline = None;
+        if !self.push_endpoint_method_with_kind(
+            crate::api::schema::Method::CommandInvoke(params),
+            PendingEndpointKind::PopupCommand,
+            outcome,
+        ) {
+            self.popup_pending = false;
+            return false;
+        }
+        true
+    }
