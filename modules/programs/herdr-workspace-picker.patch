+
+/// `ui.new_workspace_command` replaces interactive workspace creation with a
+/// popup. It is registered as a keyless custom command so the endpoint owns
+/// execution and every New Workspace entry point - keybinding, sidebar, and
+/// mobile - reaches the same picker through the command manifest.
+fn append_new_workspace_command(config: &Config, keybinds: &mut Keybinds) {
+    let command = config.ui.new_workspace_command.trim();
+    if command.is_empty() {
+        return;
+    }
+
+    keybinds.custom_commands.push(CustomCommandKeybind {
+        bindings: ActionKeybinds::default(),
+        label: NEW_WORKSPACE_COMMAND_LABEL.to_string(),
+        command: command.to_string(),
+        action: CustomCommandAction::Popup,
+        description: Some("new workspace picker".to_string()),
+        width: Some(NEW_WORKSPACE_COMMAND_SIZE),
+        height: Some(NEW_WORKSPACE_COMMAND_SIZE),
+    });
 }
 
